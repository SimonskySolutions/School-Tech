# The monthly restore drill (M8.7, ADR 0037), started by
# pythagoras-restore-drill.timer. Install both on the host:
#   sudo cp infra/systemd/pythagoras-restore-drill.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pythagoras-restore-drill.timer
# The paths are the ones in docs/operations.md; change them here if the host
# keeps the files elsewhere. A failed drill shows in `systemctl status` and,
# through the measures it no longer updates, as the RestoreCheckOverdue alert.
[Unit]
Description=Pythagoras restore drill
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker compose -f /etc/pythagoras/compose.production.yaml --env-file /etc/pythagoras/.env run --rm --no-TTY restore-drill
# The drill's own limit is 4 hours; give it a little more to report.
TimeoutStartSec=5h
