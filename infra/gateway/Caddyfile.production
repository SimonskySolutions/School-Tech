# Production gateway (ADR 0015). Not used in development.
#
# Environment:
#   ACME_EMAIL   contact address for the certificate authority
#   PORTAL_HOST  family and staff portal, e.g. portal.example.bg
#   AUTH_HOST    identity provider host name, e.g. auth.example.bg
#   API_HOST     public API host name, e.g. api.example.bg (health and webhooks only)
#   CMS_HOST     website editor, e.g. cms.example.bg
#   LOCAL_CERTS  "local_certs" to sign every certificate with Caddy's own
#                authority instead of Let's Encrypt (the local and CI proof of
#                the production stack, ADR 0033); empty in production
#
# Every other host name gets a certificate on demand, but only after the API
# confirms it is a verified domain of a live website. A new school website goes
# live by adding and verifying its domain in the platform; no gateway change.
{
	admin off
	email {$ACME_EMAIL}
	{$LOCAL_CERTS}
	on_demand_tls {
		ask http://api:3000/internal/tls/allowed
	}
	servers {
		trusted_proxies static private_ranges
	}
}

# Health check for Compose, on a port that is never published.
http://:8080 {
	respond /healthz "ok" 200
	respond "Not found" 404
}

(no_banner) {
	header -Server
	header -X-Powered-By
}

(proxy_defaults) {
	import no_banner
	header Strict-Transport-Security "max-age=31536000"
	request_header X-Request-Id {http.request.uuid}
}

{$PORTAL_HOST} {
	import proxy_defaults
	@internal path /internal /internal/*
	respond @internal "Not found" 404
	reverse_proxy web:3000
}

{$CMS_HOST} {
	import proxy_defaults
	reverse_proxy cms:3000
}

{$AUTH_HOST} {
	import proxy_defaults
	# The administration console is not public; administer through an SSH tunnel.
	@admin path /admin /admin/*
	respond @admin "Not found" 404
	reverse_proxy keycloak:8080
}

{$API_HOST} {
	import proxy_defaults
	@public path /health/live /health/ready /webhooks/*
	handle @public {
		reverse_proxy api:3000
	}
	handle {
		respond "Not found" 404
	}
}

https:// {
	import proxy_defaults
	tls {
		on_demand
	}
	@internal path /internal /internal/*
	respond @internal "Not found" 404
	reverse_proxy web:3000
}
