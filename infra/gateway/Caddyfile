# Development gateway (ADR 0011, 0015). Plain HTTP on the Compose network;
# the host publishes it on 127.0.0.1:${GATEWAY_HOST_PORT:-53000}.
# Production uses Caddyfile.production (HTTPS, verified domains only).
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

(no_banner) {
	header -Server
	header -X-Powered-By
}

(proxy_defaults) {
	import no_banner
	request_header X-Request-Id {http.request.uuid}
}

# One canonical address for the portal, so sign-in cookies always belong to it.
http://localhost {
	import no_banner
	redir {$PORTAL_URL}{uri} 308
}

# Family portal and staff workspaces.
http://portal.pythagoras.localhost {
	import proxy_defaults
	reverse_proxy web:3000
}

# The API is reached only by the web server internally; its public face is
# limited to health checks, provider webhooks and the development payment
# provider's checkout page (ADR 0010; it answers 404 in production).
http://api.pythagoras.localhost {
	import proxy_defaults
	@public path /health/live /health/ready /webhooks/* /dev-payments/*
	handle @public {
		reverse_proxy api:3000
	}
	handle {
		respond "Not found" 404
	}
}

# Website content editors (ADR 0017): Payload's admin and REST API.
http://cms.pythagoras.localhost {
	import proxy_defaults
	reverse_proxy cms:3000
}

# School and group websites. The web app decides which website a host belongs
# to from the verified domains in the database (milestone M3).
http://pythagoras.localhost, http://*.pythagoras.localhost {
	import proxy_defaults
	reverse_proxy web:3000
}

# Anything else is not ours.
http:// {
	import no_banner
	respond "Unknown site" 421
}
