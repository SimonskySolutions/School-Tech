# Settings for compose.production.yaml (ADR 0033). Copy to /etc/pythagoras/.env
# (or anywhere outside the repository), fill in, and keep it readable by root
# only. Nothing secret goes here: passwords and keys are files in SECRETS_DIR.
#
#   docker compose -f compose.production.yaml --env-file /etc/pythagoras/.env up -d --wait

# The release being deployed: the commit CI built the images from.
IMAGE_TAG=0000000000000000000000000000000000000000
# Where the images are pulled from, ending in "/"; empty when they were loaded
# onto the host with `docker load`.
IMAGE_REGISTRY=

# Secret files, one per secret (scripts/prod-secrets.sh creates them).
SECRETS_DIR=/etc/pythagoras/secrets

# Public host names. DNS for each points at the host (docs/operations.md).
PORTAL_HOST=portal.example.bg
AUTH_HOST=auth.example.bg
API_HOST=api.example.bg
CMS_HOST=cms.example.bg
# Let's Encrypt writes here about certificates that are about to expire.
ACME_EMAIL=platform@example.bg
# Empty in production. "local_certs" signs certificates with the gateway's own
# authority instead (the local and CI proof of the stack).
LOCAL_CERTS=

# Ports the gateway is published on.
HTTP_PORT=80
HTTPS_PORT=443
# Empty in production. When HTTPS is published on another port (the local
# proof), that port as ":<port>", so every public address carries it.
PUBLIC_PORT=

# E-mail (ADR 0031): any SMTP service that accepts TLS. The password is the
# smtp_password secret.
SMTP_HOST=smtp.example.bg
SMTP_PORT=587
SMTP_REQUIRE_TLS=true
SMTP_SECURE=false
SMTP_USER=no-reply@example.bg
MAIL_FROM=Pythagoras <no-reply@example.bg>

# Documents (ADR 0029): the API's key in the object store. Garage key ids are
# "GK" and 24 hex characters; scripts/prod-secrets.sh prints a new one.
STORAGE_ACCESS_KEY_ID=GK000000000000000000000000
STORAGE_CAPACITY_GB=100
# The backup service's read-only key to the documents (M8.5), another new id.
BACKUP_STORAGE_ACCESS_KEY_ID=GK000000000000000000000001

# Off-site backups (M8.5, ADR 0035): an S3-compatible bucket in the EU, in an
# account separate from the server's. The key needs only to read, write, list
# and delete in that bucket; its secret is the backup_s3_secret_key secret.
BACKUP_S3_ENDPOINT=s3.example.eu
BACKUP_S3_PORT=443
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_BUCKET=pythagoras-backups
BACKUP_S3_KEY_ID=
# "path" (bucket in the address's path) or "host" (bucket as a host name).
BACKUP_S3_URI_STYLE=path
# Empty for storage with a publicly trusted certificate.
BACKUP_S3_CA_FILE=
# When the scheduled backups run (UTC): a full one on this ISO weekday
# (7 = Sunday), a differential on the others.
BACKUP_HOUR=1
BACKUP_FULL_DAY=7

# Monitoring (M8.6, ADR 0036): who receives the alerts, sent through the SMTP
# service above (STARTTLS required; port 465 means TLS from the start), and how
# long Prometheus keeps its measures.
ALERT_EMAIL_TO=platform@example.bg
MONITOR_RETENTION=30d
# Empty for a mail service with a publicly trusted certificate.
ALERT_SMTP_CA_FILE=
