{
  "name": "@pythagoras/web",
  "version": "0.0.0",
  "private": true,
  "description": "Pythagoras websites, family portal and staff workspaces (Next.js)",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@pythagoras/shared": "workspace:*",
    "jose": "6.2.14",
    "next": "16.4.3",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
