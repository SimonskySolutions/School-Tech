{
  "name": "pythagoras",
  "private": true,
  "description": "Central management platform for the Pythagoras school group",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "format": "prettier --write apps packages \"*.{json,mjs}\"",
    "format:check": "prettier --check apps packages \"*.{json,mjs}\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
